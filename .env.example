
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bughouse_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_LOGIN=
REDIS_PASSWORD=
REDIS_BACKEND=0

SUPERUSER_EMAIL=
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=

# Bots are created (disabled) at bootstrap and toggled by the superadmin.
BOTS_COUNT=3
BOTS_USERNAME_PREFIX=bot
BOTS_EMAIL_DOMAIN=bots.local
BOTS_PASSWORD=bot-password

CORE_HOST=core
CORE_PORT=50051

BACKEND_SECRET=YOUR_SECRET
BACKEND_WORKERS=1

# Public base URL of the backend; used to build the OAuth redirect_uri
# ({BASE_URL}/api/auth/oauth/{provider}/callback) and must match the
# redirect URI registered with each provider.
BASE_URL=http://localhost:8000
# Where the user is redirected after a successful OAuth login, and where the
# registration-completion page lives ({FRONTEND_URL}/oauth/complete).
FRONTEND_URL=http://localhost:5173

# Third-party login providers. A provider becomes available only once its
# credentials are set. google/github are confidential clients (id + secret);
# lichess uses PKCE and needs only a client id (any stable identifier).
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_LICHESS_ID=

RANKING_BETA=
RANKING_TAU=
RANKING_SIGMA=
RANKING_MU=
RANKING_EPSILON=

BOOT_LEVEL=DEBUG

NGINX_PORT=80
COMPOSE_PROFILES=with_backend,with_frontend

DOMAIN=
SUBDOMAIN=bughouse

DEPLOY_WEBHOOK_SECRET=
