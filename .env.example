# Player usernames are restricted to [a-z0-9]; give each bot a name with at
# least one other character (e.g. a capital) so it can't collide with a player.
BOTS=[{"name":"Yahoo","skill_level":5,"mu":1500,"sigma":350},{"name":"DeepBot","skill_level":18,"mu":2200,"sigma":300},{"name":"Randy","skill_level":0,"mu":1000,"sigma":350}]

# Engine tunables (binary path is fixed in the image).
ENGINE_POOL_SIZE=1
ENGINE_MAX_THINK_MS=1000

CORE_HOST=core
CORE_PORT=50051

BACKEND_SECRET=YOUR_SECRET
BACKEND_WORKERS=1

BASE_URL=http://localhost:8000

